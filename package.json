{
  "name": "astral-chronicles-arpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first 3D Anime Action RPG with per-account 3-character persistence",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "node tools/world-v2-compile.mjs",
    "build": "tsc --noEmit && vite build",
    "world:bake": "node tools/world-v2-compile.mjs",
    "world:bake:verify": "node tools/world-v2-compile.mjs --verify",
    "preview": "vite preview --host",
    "test": "vitest run",
    "audit:world": "node tools/world-v2-dependency-audit.mjs",
    "test:browser": "node tools/world-v2-browser-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
